# Copy to .env for local development (npm run dev).
# For GitHub Pages, set the same three values as repository secrets instead (see README → Deploy).
# All three end up in the browser bundle — that's expected:
#  - the TMDB read token is read-only (worst case: someone uses your request quota)
#  - the Supabase anon key is public by design; row-level security protects your data

# TMDB → https://www.themoviedb.org/settings/api → "API Read Access Token"
VITE_TMDB_READ_TOKEN=

# Supabase → Project Settings → API → Project URL / anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
