# Get a free key at https://www.themoviedb.org/settings/api
# Use EITHER the v4 "API Read Access Token" (preferred) OR the v3 "API Key".
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Express port (Vite dev server proxies /api to this)
PORT=3001

# SQLite database file (relative to the repo root)
DATABASE_PATH=data/watchlist.db

# Optional: point at a different TMDB-compatible API root (e.g. a local mock for testing)
# TMDB_BASE_URL=https://api.themoviedb.org/3
